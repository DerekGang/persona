{
  "name": "kb_get",
  "description": "Read metadata, links, summary.md and project timelines; chats include 7 days of messages. Recordings include meeting minutes or a day recap (timeline, meetings, to-dos with suggested/actual state) and any retained timestamped phone/watch transcript. Meetings/events list recordings. Topics list points by subtopic, kind, reason and source. Transcripts expire after recording_days (default 14), minutes/recaps after minutes_days (default forever). Use an id from kb_list/kb_search or a project name. Projects show the top 20 people and total (all in meta.json), storage policy and each field’s evidence cutoff. Source state describes delivery. Check deployment separately.",
  "input_schema": {
    "type": "object",
    "required": [
      "kind",
      "id"
    ],
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "projects",
          "chats",
          "people",
          "docs",
          "meetings",
          "events",
          "recordings",
          "topics"
        ]
      },
      "id": {
        "type": "string"
      }
    }
  }
}
